generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  none
  admin
  writer

  @@map("user_role")
}

enum ProductKind {
  school
  team
  exp

  @@map("product_kind")
}

enum PurchaseStatus {
  pending
  confirmed
  cancelled
  refund_pending
  refunded
  expired

  @@map("purchase_status")
}

model Product {
  id              String      @id
  title           String
  titleAr         String      @map("title_ar")
  subtitle        String
  subtitleAr      String      @map("subtitle_ar")
  description     String
  descriptionAr   String      @map("description_ar")
  photo           String
  basePriceBaisa  BigInt      @map("base_price_baisa")
  extraPriceBaisa BigInt      @default(0) @map("extra_price_baisa")
  plannedDates    DateTime[]  @default([]) @map("planned_dates") @db.Date
  photos          String[]    @default([])
  longitude       Float
  latitude        Float
  lastUpdated     DateTime    @map("last_updated") @db.Date
  isDeleted       Boolean     @map("is_deleted")
  kind            ProductKind @default(exp)
  pricePer        Int         @default(4) @map("price_per")

  purchases Purchase[]
  reviews   Review[]

  @@map("products")
}

model User {
  id     String   @id
  email  String   @unique
  name   String
  phone  String
  role   UserRole @default(none)
  locale String   @default("en")

  purchases Purchase[]
  reviews   Review[]
  blogs     Blog[]
  thawani   UserCustomerId?

  @@map("users")
}

model Purchase {
  id                String   @id @db.Uuid
  productId         String   @map("product_id")
  userId            String   @map("user_id")
  numOfParticipants Int      @map("num_of_participants")
  paid              Boolean
  costBaisa         BigInt   @map("cost_baisa")
  chosenDate        DateTime @map("chosen_date") @db.Date
  complete          Boolean
  createdAt         DateTime @default(dbgenerated("CURRENT_DATE")) @map("created_at") @db.Date
  extraPriceChosen  Boolean  @default(false) @map("extra_price_chosen")

  // Lifecycle. `complete` is legacy and dual-written until it can be dropped;
  // all reads go through `status`. `paid` remains the payment-method flag
  // (true = card via Thawani, false = cash on arrival).
  status              PurchaseStatus @default(pending)
  createdAtTs         DateTime       @default(now()) @map("created_at_ts") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  thawaniSessionId    String?        @map("thawani_session_id")
  thawaniPaymentId    String?        @map("thawani_payment_id")
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy         String?        @map("cancelled_by")
  refundedAt          DateTime?      @map("refunded_at") @db.Timestamptz(6)
  rescheduledFrom     DateTime?      @map("rescheduled_from") @db.Date
  reminderSentAt      DateTime?      @map("reminder_sent_at") @db.Timestamptz(6)
  reviewRequestSentAt DateTime?      @map("review_request_sent_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([status, chosenDate])
  @@index([userId])
  @@map("purchases")
}

model Review {
  productId   String   @map("product_id")
  userId      String   @map("user_id")
  rating      Float
  title       String
  review      String
  lastUpdated DateTime @default(dbgenerated("CURRENT_DATE")) @map("last_updated") @db.Date

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@id([productId, userId])
  @@map("reviews")
}

model UserCustomerId {
  userId     String @id @map("user_id")
  customerId String @map("customer_id")

  user User @relation(fields: [userId], references: [id])

  @@map("user_customer_id")
}

model Blog {
  id            String   @id
  title         String
  description   String
  titleAr       String   @map("title_ar")
  descriptionAr String   @map("description_ar")
  photo         String
  page          String
  pageAr        String   @map("page_ar")
  userId        String   @map("user_id")
  createdAt     DateTime @default(dbgenerated("CURRENT_DATE")) @map("created_at") @db.Date

  user User @relation(fields: [userId], references: [id])

  @@map("blogs")
}
